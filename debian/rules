#!/usr/bin/make -f
export PYBUILD_TEST_PYTEST = 1
# test_packaging.py le debian/ e packaging/, ausentes no diretorio de build
export PYBUILD_TEST_ARGS = --ignore=tests/test_packaging.py --ignore=tests/treino
%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_installsystemd:
	dh_installsystemd
	# timer de limpeza: habilitado e iniciado na instalacao; o servico oneshot (sem [Install]) so roda por ele
	dh_installsystemd --name=mandacaru-quarantine-clean
	# --no-start: sem isso o postinst roda o scan (com rede) dentro do apt; o timer e iniciado no postinst
	dh_installsystemd --no-start --name=mandacaru-vuln-scan
	dh_installsystemd --no-enable --no-start --name=mandacaru-telemetry

execute_after_dh_fixperms:
	# o config pode trazer chaves de API (VirusTotal, MalwareBazaar)
	chmod 0640 debian/mandacaru/etc/mandacaru/config.toml
	chmod 0755 debian/mandacaru/usr/libexec/mandacaru/quarantine-decide \
		debian/mandacaru/usr/libexec/mandacaru/quarantine-release

[Unit]
Description=Mandacaru - auditoria local de vulnerabilidades (CVE/CVSS via OSV.dev)
Documentation=https://github.com/VandyckLN/mandacaru
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=_mandacaru-net
Group=_mandacaru-net
# o /proc dos processos de outros usuarios so e legivel por root: o + tira o snapshot sem rede nem sandbox
ExecStartPre=+/usr/bin/mandacaru --config /etc/mandacaru/config.toml vuln snapshot-running --output /var/lib/mandacaru/vuln_cache/running.json
ExecStart=/usr/bin/mandacaru --config /etc/mandacaru/config.toml vuln scan --running-file /var/lib/mandacaru/vuln_cache/running.json --report /var/lib/mandacaru/vuln_cache/last-scan.json
# saida 2 = achou vulnerabilidade alta: o scan funcionou
SuccessExitStatus=2
StateDirectory=mandacaru/vuln_cache
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
ReadOnlyPaths=/var/lib/dpkg/status /var/lib/dpkg/info /etc/os-release /etc/mandacaru
ReadWritePaths=/var/lib/mandacaru/vuln_cache
